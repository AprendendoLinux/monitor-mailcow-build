#!/bin/bash
set -e

install -d -m 700 /var/lib/monitor-mailcow

[ -f /etc/mailcow-monitor/mailcow-monitor.conf ] && chmod 600 /etc/mailcow-monitor/mailcow-monitor.conf

touch /var/log/monitor-mailcow.log
chmod 640 /var/log/monitor-mailcow.log

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl enable mailcow-monitor.service
    systemctl restart mailcow-monitor.service || true
fi
exit 0
